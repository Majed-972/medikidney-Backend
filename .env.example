# Database
DATABASE_URL="postgresql://username:password@host:5432/database"

# Supabase Storage
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="medical-files"
SUPABASE_STORAGE_SIGNED_URL_EXPIRY_SECONDS=300

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email Service
# Recommended in production, especially on Render/Railway: use an HTTP API provider such as Resend.
# MAIL_FROM_EMAIL must belong to a verified sending domain in your provider.
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM_EMAIL=no-reply@updates.example.com
MAIL_FROM_NAME=MediKidney System
# Optional:
# RESEND_API_BASE_URL=https://api.resend.com
#
# SMTP fallback (useful for local development or platforms that allow outbound SMTP)
# Note:
# - Render free web services block outbound SMTP on ports 25/465/587.
# - Railway Free/Trial/Hobby plans disable SMTP.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
#
# Optional SMTP tuning:
# MAIL_CONNECTION_TIMEOUT_MS=10000
# MAIL_GREETING_TIMEOUT_MS=10000
# MAIL_SOCKET_TIMEOUT_MS=20000
#
# Backward-compatible Gmail aliases supported by the current code:
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

# Application
NODE_ENV=development
